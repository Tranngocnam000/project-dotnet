@model IEnumerable<MobileViewModel>

@{
    ViewData["Title"] = "Mobile List";
}

<h1 class="text-center mt-4 text-primary">Mobile List</h1>

<div class="row">
    <div class="col-md-8">
        <a asp-action="Create" class="btn btn-success mb-3">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </div>
    <div class="col-md-4">
        <form asp-action="Index" method="get" class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Search by name..." value="@ViewData["SearchName"]">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
        </form>
    </div>
</div>

<div class="card shadow-lg">
    <div class="card-body">
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Price)</th>
                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                    <th>@Html.DisplayNameFor(model => model.ImageUrl)</th>
                    <th>@Html.DisplayNameFor(model => model.Category)</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Price)</td>
                        <td>@Html.DisplayFor(modelItem => item.Description)</td>
                        <td>
                            <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid rounded" style="max-width: 100px;">
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.CategoryName)</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
