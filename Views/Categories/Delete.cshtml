@model Phone.Data.Entities.Category

@{
    ViewData["Title"] = "Delete Category";
}

<h1 class="text-center mt-4 text-danger">Delete Category</h1>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="alert alert-danger text-center" role="alert">
            <h4 class="alert-heading">Are you sure you want to delete this?</h4>
            <p>This action cannot be undone.</p>
        </div>

        <div class="card shadow-lg">
            <div class="card-body">
                <h4 class="card-title text-center text-secondary">Category Information</h4>
                <hr />

                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th class="bg-light">Category Name</th>
                            <td>@Html.DisplayFor(model => model.CategoryName)</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Created At</th>
                            <td>@Html.DisplayFor(model => model.CreateAt)</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Updated At</th>
                            <td>@Html.DisplayFor(model => model.UpdatedAt)</td>
                        </tr>
                    </tbody>
                </table>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this category?')">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
