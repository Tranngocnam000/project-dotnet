@model Phone.Data.Entities.Category

@{
    ViewData["Title"] = "Category Details";
}

<h1 class="text-center mt-4 text-primary">Category Details</h1>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-lg">
            <div class="card-body">
                <h4 class="card-title text-center text-secondary">Category Information</h4>
                <hr />

                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th class="bg-light">Category Name</th>
                            <td>@Html.DisplayFor(model => model.CategoryName)</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Created At</th>
                            <td>@Html.DisplayFor(model => model.CreateAt)</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Updated At</th>
                            <td>@Html.DisplayFor(model => model.UpdatedAt)</td>
                        </tr>
                    </tbody>
                </table>

                <div class="d-flex justify-content-between mt-3">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
